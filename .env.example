# Copia este archivo a .env para desarrollo local
PORT=3000
NODE_ENV=development
# Postgres local o la "External Database URL" de Render
DATABASE_URL=postgresql://postgres:141207@localhost:5432/marketico

# Solo para conexiones remotas que requieran SSL (en producción es true por defecto)
# DATABASE_SSL=true
# Cadena larga y aleatoria (en Render se genera sola con render.yaml)
JWT_SECRET=141207
# URL pública de tu app (sin "/" al final). Necesaria para el login con Google/Facebook
BASE_URL=http://localhost:3000

# Login con Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login con Facebook (https://developers.facebook.com/apps)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
